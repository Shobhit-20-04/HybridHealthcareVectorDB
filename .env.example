# ==============================================================================
# Database Configuration (PostgreSQL + pgvector)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_vectordb
DB_USER=postgres
DB_PASSWORD=change_this_to_your_secure_password
DB_SSLMODE=prefer

# ==============================================================================
# Embedding Model Configurations
# ==============================================================================
# Text Embeddings: Default local HuggingFace model (clinical / general biomedical or sentence transformer)
# Common benchmarks:
# - sentence-transformers/all-MiniLM-L6-v2 (dim: 384)
# - pritamdeka/S-PubMedBert-MS-MARCO (dim: 768)
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_EMBEDDING_DIM=384

# Multimodal / Vision Embeddings (e.g. for medical imaging like X-ray/pathology projections):
# - openai/clip-vit-base-patch32 (dim: 512)
# - microsoft/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224 (dim: 512)
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32
IMAGE_EMBEDDING_DIM=512

# Inference Hardware Device ('cpu', 'cuda', 'mps')
DEVICE=cpu

# ==============================================================================
# Vector Index Default Tuning Parameters
# ==============================================================================
# HNSW default parameters
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# IVFFlat default parameters
IVFFLAT_LISTS=100
IVFFLAT_PROBES=10

# ==============================================================================
# Security & Access Control Configuration (Least-Privilege Roles)
# ==============================================================================
RBAC_ENABLED=true
AUDIT_LOG_ENABLED=true

# Database Role Test Accounts (Synthetic Test Credentials)
DB_USER_ADMIN=user_admin
DB_PASS_ADMIN=Admin_Secure_Pass_2026!

DB_USER_PHYSICIAN=user_physician
DB_PASS_PHYSICIAN=Physician_Secure_Pass_2026!

DB_USER_RADIOLOGIST=user_radiologist
DB_PASS_RADIOLOGIST=Radiologist_Secure_Pass_2026!

DB_USER_RESEARCHER=user_researcher
DB_PASS_RESEARCHER=Researcher_Secure_Pass_2026!

# ==============================================================================
# Benchmarking Configuration
# ==============================================================================
BENCHMARK_NUM_QUERIES=50
BENCHMARK_WARMUP_RUNS=5
BENCHMARK_REPETITIONS=10
BENCHMARK_TOP_K=10

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
